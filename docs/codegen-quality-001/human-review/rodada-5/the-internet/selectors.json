{
  "schema": "nekkora-rpa/selectors",
  "version": "1.1.0",
  "system": "process",
  "targets": {
    "process.access.username": {
      "preferred": {
        "strategy": "css",
        "expression": "input#username"
      },
      "alternatives": [
        {
          "strategy": "css",
          "expression": "input[name=\"username\"]"
        },
        {
          "strategy": "label",
          "text": "Username"
        },
        {
          "strategy": "css",
          "expression": "form#login input#username"
        }
      ],
      "expected": {
        "tag": "input",
        "role": "textbox",
        "name": "Username"
      },
      "provenance": {
        "studioStepId": "4b74b3c8-17e6-4e58-8dab-933f68406554"
      }
    },
    "process.access.password": {
      "preferred": {
        "strategy": "css",
        "expression": "input#password"
      },
      "alternatives": [
        {
          "strategy": "css",
          "expression": "input[name=\"password\"]"
        },
        {
          "strategy": "label",
          "text": "Password"
        },
        {
          "strategy": "css",
          "expression": "form#login input#password"
        }
      ],
      "expected": {
        "tag": "input",
        "label": "Password"
      },
      "provenance": {
        "studioStepId": "54a62500-1d69-4741-824c-bc5c05c5424f"
      }
    },
    "process.access.login": {
      "preferred": {
        "strategy": "xpath",
        "expression": "//form[@id=\"login\"]//button[normalize-space(.)=\"Login\"]"
      },
      "alternatives": [
        {
          "strategy": "role",
          "role": "button",
          "name": "Login"
        },
        {
          "strategy": "xpath",
          "expression": "//button[normalize-space(.)=\"Login\"]"
        },
        {
          "strategy": "css",
          "expression": "form#login > button"
        }
      ],
      "expected": {
        "tag": "button",
        "role": "button",
        "name": "Login"
      },
      "provenance": {
        "studioStepId": "e2c24a93-83af-438e-9d0f-e45832a7e2c8"
      }
    },
    "process.secure_area.logout": {
      "preferred": {
        "strategy": "xpath",
        "expression": "//a[normalize-space(.)=\"Logout\"]"
      },
      "alternatives": [
        {
          "strategy": "role",
          "role": "link",
          "name": "Logout"
        },
        {
          "strategy": "css",
          "expression": "div#content > div > a"
        }
      ],
      "expected": {
        "tag": "a",
        "role": "link",
        "name": "Logout"
      },
      "provenance": {
        "studioStepId": "fe1c99f1-6ff8-4d0e-a58d-10e5ad44e978"
      }
    }
  }
}
