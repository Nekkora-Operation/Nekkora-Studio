{
  "schema": "nekkora-rpa/selectors",
  "version": "1.1.0",
  "system": "process",
  "targets": {
    "process.access.username": {
      "preferred": {
        "strategy": "css",
        "expression": "input#username"
      },
      "alternatives": [
        {
          "strategy": "css",
          "expression": "input[name=\"username\"]"
        },
        {
          "strategy": "label",
          "text": "Username"
        },
        {
          "strategy": "css",
          "expression": "form#login input#username"
        }
      ],
      "expected": {
        "tag": "input",
        "role": "textbox",
        "name": "Username"
      },
      "provenance": {
        "studioStepId": "38eeb197-71fd-4002-b88f-df31516000ac"
      }
    },
    "process.access.password": {
      "preferred": {
        "strategy": "css",
        "expression": "input#password"
      },
      "alternatives": [
        {
          "strategy": "css",
          "expression": "input[name=\"password\"]"
        },
        {
          "strategy": "label",
          "text": "Password"
        },
        {
          "strategy": "css",
          "expression": "form#login input#password"
        }
      ],
      "expected": {
        "tag": "input",
        "label": "Password"
      },
      "provenance": {
        "studioStepId": "e0c9d009-08a0-4d3c-a9a0-5d6e48497582"
      }
    },
    "process.access.login": {
      "preferred": {
        "strategy": "xpath",
        "expression": "//form[@id=\"login\"]//button[normalize-space(.)=\"Login\"]"
      },
      "alternatives": [
        {
          "strategy": "role",
          "role": "button",
          "name": "Login"
        },
        {
          "strategy": "xpath",
          "expression": "//button[normalize-space(.)=\"Login\"]"
        },
        {
          "strategy": "css",
          "expression": "form#login > button"
        }
      ],
      "expected": {
        "tag": "button",
        "role": "button",
        "name": "Login"
      },
      "provenance": {
        "studioStepId": "5f6867af-dbbc-4520-804b-1b9c621bc67b"
      }
    },
    "process.secure_area.logout": {
      "preferred": {
        "strategy": "xpath",
        "expression": "//a[normalize-space(.)=\"Logout\"]"
      },
      "alternatives": [
        {
          "strategy": "role",
          "role": "link",
          "name": "Logout"
        },
        {
          "strategy": "css",
          "expression": "div#content > div > a"
        }
      ],
      "expected": {
        "tag": "a",
        "role": "link",
        "name": "Logout"
      },
      "provenance": {
        "studioStepId": "ff55ea77-6734-4b5f-b102-edf3f3bfa6a8"
      }
    }
  }
}
