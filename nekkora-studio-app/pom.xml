<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.nekkora</groupId>
    <artifactId>nekkora-studio-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>nekkora-studio-app</artifactId>
  <name>Nekkora Studio App</name>
  <description>Aplicação desktop do Nekkora Studio: inicialização, estado da área de trabalho, casos de uso e coordenação entre domínio e UI.</description>

  <properties>
    <studio.main>com.nekkora.studio.app.StudioApplication</studio.main>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.nekkora</groupId>
      <artifactId>nekkora-studio-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>com.nekkora</groupId>
      <artifactId>nekkora-studio-ui</artifactId>
    </dependency>
    <dependency>
      <groupId>com.nekkora</groupId>
      <artifactId>nekkora-studio-recorder</artifactId>
    </dependency>
    <dependency>
      <groupId>com.nekkora</groupId>
      <artifactId>nekkora-studio-persistence</artifactId>
    </dependency>
    <dependency>
      <!-- STUDIO-007: Automation Validation Engine (Java puro) -->
      <groupId>com.nekkora</groupId>
      <artifactId>nekkora-studio-validation</artifactId>
    </dependency>
    <dependency>
      <!-- STUDIO-008: contrato semântico — só nos testes (desempenho e homologação); o Studio não o persiste nem o envia -->
      <groupId>com.nekkora</groupId>
      <artifactId>nekkora-studio-semantics</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- STUDIO-009: plano do debug guiado e regra de reuso -->
      <groupId>com.nekkora</groupId>
      <artifactId>nekkora-studio-guided</artifactId>
    </dependency>
    <dependency>
      <groupId>com.nekkora</groupId>
      <artifactId>nekkora-studio-pdd</artifactId>
    </dependency>
    <dependency>
      <groupId>com.nekkora</groupId>
      <artifactId>nekkora-studio-codegen</artifactId>
    </dependency>
    <dependency>
      <groupId>com.nekkora</groupId>
      <artifactId>nekkora-studio-bridge</artifactId>
    </dependency>
    <dependency>
      <groupId>com.nekkora</groupId>
      <artifactId>nekkora-swing-ui</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <executions>
          <execution>
            <id>default-test</id>
            <configuration>
              <excludes>
                <exclude>**/Scale150Test.java</exclude>
                <exclude>**/Variables150Test.java</exclude>
              </excludes>
            </configuration>
          </execution>
          <!-- S001-017: a escala só pode ser escolhida antes de instalar o Look and Feel, então roda em JVM própria -->
          <execution>
            <id>scale-150</id>
            <goals><goal>test</goal></goals>
            <configuration>
              <includes>
                <include>**/Scale150Test.java</include>
                <include>**/Variables150Test.java</include>
              </includes>
              <reportNameSuffix>scale150</reportNameSuffix>
              <systemPropertyVariables>
                <flatlaf.uiScale>1.5</flatlaf.uiScale>
              </systemPropertyVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>${studio.main}</mainClass>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>nekkora-studio</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${studio.main}</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
