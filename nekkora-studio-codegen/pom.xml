    </dependency>
    <dependency>
      <groupId>com.nekkora</groupId>
      <artifactId>nekkora-studio-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>com.nekkora</groupId>
      <artifactId>nekkora-studio-guided</artifactId>
    </dependency>
    <dependency>
      <!-- JSON estrito do Studio -->
      <groupId>com.nekkora</groupId>
      <artifactId>nekkora-studio-bridge</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
